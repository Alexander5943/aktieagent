{
  // Cloudflare Worker för Aktieagent. Databasen (KV) skapas automatiskt vid första deploy.
  "name": "aktieagent",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [{ "binding": "AKTIE_KV" }],
  "triggers": { "crons": [] },  // måndagens AI-uppdatering körs från GitHub (ai_vecka.py)
  // AI_AV "1" = all AI avstängd (kostar inget). Ändra till "0" för att slå på igen.
  "vars": { "AI_DAILY_LIMIT": "25", "AI_AV": "1" }
}
